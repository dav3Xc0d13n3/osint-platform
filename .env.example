# OSINT Platform - Environment Configuration Example
# Copy to .env and fill in values. Never commit .env with real secrets.

# App
APP_NAME="OSINT Platform"
APP_VERSION="1.0.0"
DEBUG=false
API_V1_PREFIX="/api/v1"

# Database (required)
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis (required)
REDIS_URL=redis://localhost:6379/0
REDIS_DB=0

# Security (required)
SECRET_KEY=your-super-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_HEADER=X-API-Key

# CORS - JSON array OR comma-separated string
# Production: set to your frontend URL(s)
# CORS_ORIGINS=["https://your-frontend.onrender.com"]
# CORS_ORIGINS=https://your-frontend.onrender.com,https://another-domain.com
CORS_ORIGINS=["http://localhost:3000"]

# Rate Limiting
DEFAULT_RATE_LIMIT=100/minute
USERNAME_CONCURRENCY=50
IMAGE_CONCURRENCY=10
LINK_CONCURRENCY=20

# External APIs (optional - add in Render dashboard for production)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
YANDEX_API_KEY=
TINEYE_API_KEY=
BING_API_KEY=
VIRUSTOTAL_API_KEY=
URLHAUS_API_KEY=
ALIENVAULT_API_KEY=

# Celery (not used - BackgroundTasks instead)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# File Upload
MAX_UPLOAD_SIZE=10485760
ALLOWED_IMAGE_TYPES=["image/jpeg","image/png","image/webp","image/gif"]

# Timeouts
HTTP_TIMEOUT=30
JOB_TIMEOUT=300