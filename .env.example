# OSINT Platform Environment Variables
# Copy to .env and fill in your values

# Database
DATABASE_URL=postgresql+asyncpg://osint:osint@postgres:5432/osint

# Redis
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
API_KEY_HEADER=X-API-Key

# CORS
CORS_ORIGINS=["http://localhost:3000","https://yourdomain.com"]

# Rate Limiting
DEFAULT_RATE_LIMIT=100/minute
USERNAME_CONCURRENCY=50
IMAGE_CONCURRENCY=10
LINK_CONCURRENCY=20

# External APIs (Optional - add keys for enhanced functionality)
# Google Custom Search API
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Yandex Images API
YANDEX_API_KEY=

# TinEye API
TINEYE_API_KEY=

# Bing Visual Search API
BING_API_KEY=

# VirusTotal API
VIRUSTOTAL_API_KEY=

# URLhaus API
URLHAUS_API_KEY=

# AlienVault OTX API
ALIENVAULT_API_KEY=

# Celery
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Frontend
VITE_API_URL=http://localhost:8000/api/v1

# Debug
DEBUG=false